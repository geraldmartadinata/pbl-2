{
  "info": {
    "name": "HIMTI Registration App API",
    "description": "API collection for HIMTI Membership Registration App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/v1/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "health"]
            }
          }
        },
        {
          "name": "Get Divisions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/v1/divisions",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "divisions"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Budi Santoso\",\n  \"nim\": \"2801234567\",\n  \"email\": \"budi@example.com\",\n  \"phone\": \"081234567890\",\n  \"studyProgram\": \"Computer Science\",\n  \"intakeYear\": 2026,\n  \"campus\": \"Kemanggisan\",\n  \"password\": \"StrongPassword123\",\n  \"confirmPassword\": \"StrongPassword123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@example.com\",\n  \"password\": \"StrongPassword123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Applicant",
      "item": [
        {
          "name": "Submit Application",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"divisionId\": \"<replace-with-division-uuid>\",\n  \"motivation\": \"I want to contribute to HIMTI and improve my organizational skills.\",\n  \"reasonForJoining\": \"I want to collaborate with other students and build useful programs.\",\n  \"relevantSkills\": \"JavaScript, React, Express, PostgreSQL\",\n  \"organizationalExperience\": \"Class committee member\",\n  \"timeCommitmentAgreed\": true,\n  \"portfolioUrl\": \"https://example.com\",\n  \"linkedinUrl\": \"\",\n  \"githubUrl\": \"https://github.com/example\",\n  \"additionalNotes\": \"\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/applications",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "applications"]
            }
          }
        },
        {
          "name": "Get My Application",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/applications/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "applications", "me"]
            }
          }
        },
        {
          "name": "Update My Application",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"relevantSkills\": \"JavaScript, React, Express, PostgreSQL, Node.js\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/applications/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "applications", "me"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"08999999999\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/users/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/admin/statistics",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "admin", "statistics"]
            }
          }
        },
        {
          "name": "Get Applications List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/admin/applications?page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "admin", "applications"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Application Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/admin/applications/<replace-with-application-uuid>",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "admin", "applications", "<replace-with-application-uuid>"]
            }
          }
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\",\n  \"adminNote\": \"Applicant meets the requirements.\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/admin/applications/<replace-with-application-uuid>/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "admin", "applications", "<replace-with-application-uuid>", "status"]
            }
          }
        }
      ]
    }
  ]
}
